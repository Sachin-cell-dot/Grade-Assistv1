# Application
GRADEASSIST_APP_NAME=GradeAssist
GRADEASSIST_ENVIRONMENT=development
GRADEASSIST_DEBUG=false
GRADEASSIST_LOG_LEVEL=INFO

# Confidence policy: fixed escalation rail plus independent adaptive bounds.
# AUTO_APPROVE_THRESHOLD is clamped to [THRESHOLD_MIN_CLAMP, THRESHOLD_MAX_CLAMP].
ESCALATION_FLOOR=0.60
THRESHOLD_MIN_CLAMP=0.72
THRESHOLD_MAX_CLAMP=0.95
AUTO_APPROVE_THRESHOLD=0.85
RECALIBRATION_TIGHTEN_STEP=0.01
RECALIBRATION_WIDEN_STEP=0.05
DUAL_READ_AGREEMENT_MIN=0.90
NAME_FUZZY_MATCH_THRESHOLD=0.85

# Storage (relative paths are resolved from the project root)
GRADEASSIST_DATABASE_PATH=database/gradeassist.db
GRADEASSIST_DATA_DIR=data

# Local Ollama vision service (used only when the extraction pipeline is added)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_VISION_TIMEOUT_SECONDS=180
OLLAMA_VISION_NUM_PREDICT=4096
OLLAMA_VISION_NUM_CTX=8192

# Optional hosted LLM: reserved for genuine grey-zone reasoning only
HOSTED_LLM_API_KEY=
HOSTED_LLM_BASE_URL=
HOSTED_LLM_MODEL=

# Optional Twilio WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional SMTP email fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
